{
  "engines": {
    "node": ">=16.0.0"
  },
  "type": "module",
  "devDependencies": {
    "@wdio/allure-reporter": "^8.3.5",
    "@wdio/cli": "^8.3.3",
    "@wdio/cucumber-framework": "^8.3.0",
    "@wdio/local-runner": "^8.3.3",
    "@wdio/spec-reporter": "^8.3.0",
    "allure-commandline": "^2.21.0",
    "chromedriver": "^122.0.4",
    "cross-env": "^7.0.3",
    "node-fetch": "^3.3.0",
    "robotjs": "^0.6.0",
    "serve": "^14.2.0",
    "ts-node": "^10.9.1",
    "typescript": "^4.9.5",
    "wdio-chromedriver-service": "^8.0.1"
  },
  "scripts": {
    "wdio": "wdio run ./wdio.conf.js",
    "wdio:test:smoke": "wdio run ./wdio.conf.js --cucumberOpts.tagExpression=\"@test and @smoke\"",
    "wdio:test:regression": "wdio run ./wdio.conf.js --cucumberOpts.tagExpression=\"@test and @regression\"",
    "wdio:report": "npm run wdio:report:generate && npm run wdio:report:open",
    "wdio:report:generate": "allure generate --clean allure-results/",
    "wdio:report:open": "serve -s allure-report"
  }
}
